local function tween(obj, props, info) TweenService:Create(obj, info or TI, props):Play() end

local function viewport()
    local vp = floatGui.AbsoluteSize
    if vp.X < 10 then local cam = workspace.CurrentCamera; vp = cam and cam.ViewportSize or Vector2.new(800,600) end
    return vp
end

local function clampPos(x, y)
    local vp = viewport()
    return math.clamp(x, 0, math.max(0, vp.X - BTN_SIZE)), math.clamp(y, 0, math.max(0, vp.Y - BTN_SIZE))
end

local function makeIconKit(holder, paints)
    local function F(x, y, w, h, round, noPaint)
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0; f.BackgroundColor3 = ICON_OFF
        f.Position = UDim2.fromOffset(x, y); f.Size = UDim2.fromOffset(w, h)
        if round then local c = Instance.new("UICorner"); c.CornerRadius = round == true and UDim.new(1,0) or UDim.new(0, round); c.Parent = f end
        f.Parent = holder
        if not noPaint then paints[#paints+1] = { f, "BackgroundColor3" } end
        return f
    end
    local function R(x, y, w, h, thick)
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0; f.BackgroundTransparency = 1
        f.Position = UDim2.fromOffset(x, y); f.Size = UDim2.fromOffset(w, h)
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1,0); c.Parent = f
        local s = Instance.new("UIStroke"); s.Color = ICON_OFF; s.Thickness = thick; s.Parent = f
        f.Parent = holder
        paints[#paints+1] = { s, "Color" }
        return f
    end
    return F, R
end

