    AxxMusic = Instance.new("Sound")
    AxxMusic.Name = "AxxHub_MusicPlayer"
    AxxMusic.Volume = 0.5
    AxxMusic.Parent = SoundService
end

local musicState = { CurrentIndex = 1, Shuffle = false, Repeat = false, CustomId = "" }

local function getSongNames()
    local n = {}
    for i, s in ipairs(Songs) do n[i] = s.Name end
    return n
end

local DropSongs

local function playSong(index)
    local song = Songs[index]
    if not song then return end
    musicState.CurrentIndex = index
    AxxMusic:Stop()
    AxxMusic.SoundId = "rbxassetid://" .. song.Id
    AxxMusic.TimePosition = 0
    AxxMusic:Play()
    pcall(function() DropSongs:Set(song.Name) end)
    WindUI:Notify({
        Title = "♪ Reproduciendo",
        Content = song.Name,
        Icon = "solar:music-note-bold",
        Duration = 2,
    })
end

local function nextSong()
    if musicState.Shuffle then
        playSong(math.random(1, #Songs))
    else
        playSong(musicState.CurrentIndex % #Songs + 1)
    end
end

local function prevSong()
    local idx = musicState.CurrentIndex - 1
    if idx < 1 then idx = #Songs end
    playSong(idx)
end

DropSongs = tabMusic:Dropdown({
    Title = "Lista de Canciones",
    Desc = "Selecciona una canción para reproducirla",
    Values = getSongNames(),
    Value = Songs[1].Name,
    Callback = function(v)
        for i, s in ipairs(Songs) do
            if s.Name == v then playSong(i); break end
        end
    end,
})

tabMusic:Section({ Title = "Controles", Icon = "solar:play-bold" })
tabMusic:Button({ Title="▶ Reproducir / Reanudar", Icon="solar:play-bold", Callback=function()
    if AxxMusic.SoundId == "" or AxxMusic.SoundId == nil then
        playSong(musicState.CurrentIndex)
    elseif not AxxMusic.IsPlaying then
        AxxMusic:Resume()
    end
end })

tabMusic:Button({ Title="Ⅱ Pausar", Icon="solar:pause-bold", Callback=function() AxxMusic:Pause() end })
