local buttons = {}
local function createButton(def, index)
    local btn = Instance.new("TextButton")
    btn.Name = def.Name; btn.Text = ""; btn.AutoButtonColor = false; btn.Active = true
    btn.BorderSizePixel = 0; btn.BackgroundColor3 = BG_OFF; btn.BackgroundTransparency = 0.12
    btn.Size = UDim2.fromOffset(BTN_SIZE, BTN_SIZE); btn.Parent = floatGui
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,16); corner.Parent = btn
    local stroke = Instance.new("UIStroke"); stroke.Color = Color3.new(1,1,1); stroke.Transparency = 0.75; stroke.Thickness = 1.5; stroke.Parent = btn
    local scale = Instance.new("UIScale"); scale.Scale = 1; scale.Parent = btn
    local holder = Instance.new("Frame"); holder.BackgroundTransparency = 1; holder.AnchorPoint = Vector2.new(0.5,0.5); holder.Position = UDim2.fromScale(0.5,0.5); holder.Size = UDim2.fromOffset(30,30); holder.Parent = btn
    local paints = {}
    local F, R = makeIconKit(holder, paints)
    Icons[def.Name](F, R)
    local function goHome()
        local vp = viewport()
        local x, y = clampPos(vp.X - BTN_SIZE - 16, vp.Y * 0.28 + (index-1) * (BTN_SIZE+10))
        btn.Position = UDim2.fromOffset(x, y)
    end
    goHome()
    local isOn = nil
    local function setVisual(on, instant)
        if isOn == on then return end
        local first = isOn == nil; isOn = on
        local info = (instant or first) and TweenInfo.new(0) or TI
        tween(btn, { BackgroundColor3 = on and BG_ON or BG_OFF, BackgroundTransparency = on and 0.05 or 0.12 }, info)
        tween(stroke, { Color = on and ACCENT or Color3.new(1,1,1), Transparency = on and 0 or 0.75, Thickness = on and 2.5 or 1.5 }, info)
        for _, p in ipairs(paints) do tween(p[1], { [p[2]] = on and ACCENT2 or ICON_OFF }, info) end
        if not instant and not first then
            tween(scale, { Scale = 1.14 }, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
            task.delay(0.1, function() tween(scale, { Scale = 1 }, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)) end)
        end
    end
    local dragging, moved = false, false
    local dragInput, startMouse, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging, moved = true, false
        dragInput = input
        startMouse = Vector2.new(input.Position.X, input.Position.Y)
        startPos   = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)
        tween(scale, { Scale = 0.9 }, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - startMouse
        if not moved and delta.Magnitude > 7 then moved = true; tween(scale, { Scale = 1.08 }, TweenInfo.new(0.12)) end
        if moved then local x, y = clampPos(startPos.X + delta.X, startPos.Y + delta.Y); btn.Position = UDim2.fromOffset(x, y) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not dragging or input ~= dragInput then return end
        dragging = false
        tween(scale, { Scale = 1 }, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
        if not moved then toggleThing(def); task.wait(0.03); setVisual(def.StateGet() == true) end
    end)
    setVisual(def.StateGet() == true, true)
    return {
        Sync = function() setVisual(def.StateGet() == true) end,
        Reclamp = function() local x, y = clampPos(btn.Position.X.Offset, btn.Position.Y.Offset); btn.Position = UDim2.fromOffset(x, y) end,
        Home = goHome,
        SetVisible = function(v) btn.Visible = v end,
    }
end

